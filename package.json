{
  "name": "open-cmms",
  "version": "0.1.0",
  "private": true,
  "description": "WorkAxis \u2014 computerized maintenance management system (CMMS) for facilities, assets, work orders, preventive maintenance, inspections and inventory.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/free-e2e-port.mjs",
    "test:e2e": "playwright test",
    "pretest:screenshots": "node scripts/free-e2e-port.mjs",
    "test:screenshots": "playwright test tests/e2e/screenshots --retries=0 --trace=retain-on-failure",
    "pretest:write-instruments": "node scripts/free-e2e-port.mjs",
    "test:write-instruments": "playwright test tests/e2e/write-instrument --retries=0 --trace=retain-on-failure",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "date-fns": "4.4.0",
    "jsbarcode": "3.12.3",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "next-intl": "4.14.4",
    "qr-scanner": "1.4.2",
    "qrcode.react": "4.2.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "read-excel-file": "9.3.10",
    "recharts": "3.10.1",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "read-excel-file": "9.3.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
